# Application
APP_ENV=development
APP_NAME=Anlu Health
APP_BASE_URL=http://localhost:8000
DATABASE_URL=sqlite:///./anlu.db
COOKIE_SECURE=false
SESSION_DAYS=7
ALLOW_REGISTRATION=true
SAVE_CHAT_HISTORY=false
# Required only when SAVE_CHAT_HISTORY=true. Generate with:
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
DATA_ENCRYPTION_KEY=
EMERGENCY_NUMBER=995
EMERGENCY_REGION=Singapore

# Model inference. `mock` is for local UI/testing only and is rejected in production.
MODEL_PROVIDER=mock
MODEL_API_URL=
MODEL_API_TOKEN=
HF_TOKEN=
MODEL_NAME=Qwen/Qwen3.5-9B:cheapest
MODEL_TIMEOUT_SECONDS=45

# Embeddings. Point the OpenAI-compatible option at a hosted multilingual model.
EMBEDDING_PROVIDER=mock
EMBEDDING_API_URL=
EMBEDDING_API_TOKEN=
EMBEDDING_MODEL=intfloat/multilingual-e5-small
EMBEDDING_DIMENSIONS=384

# Hosted production example (HF_TOKEN is one fine-grained inference-only token used for both):
# MODEL_API_URL=https://router.huggingface.co/v1
# MODEL_NAME=Qwen/Qwen3.5-9B:cheapest
# EMBEDDING_PROVIDER=tei
# EMBEDDING_API_URL=https://router.huggingface.co/hf-inference/models/intfloat/multilingual-e5-small

# Optional distributed rate limiting and observability
REDIS_URL=
SENTRY_DSN=
METRICS_TOKEN=
LOG_LEVEL=INFO
