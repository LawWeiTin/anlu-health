# Application
APP_ENV=development
APP_NAME=HealthBridge
APP_BASE_URL=http://localhost:8000
DATABASE_URL=sqlite:///./healthbridge.db
COOKIE_SECURE=false
SESSION_DAYS=7
ALLOW_REGISTRATION=true
SAVE_CHAT_HISTORY=false
# Required only when SAVE_CHAT_HISTORY=true. Generate with:
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
DATA_ENCRYPTION_KEY=
EMERGENCY_NUMBER=995
EMERGENCY_REGION=Singapore

# Model inference. `mock` is for local UI/testing only and is rejected in production.
MODEL_PROVIDER=mock
MODEL_API_URL=
MODEL_API_TOKEN=
MODEL_NAME=google/medgemma-1.5-4b-it
MODEL_TIMEOUT_SECONDS=45

# Embeddings. Point the OpenAI-compatible option at a hosted multilingual model.
EMBEDDING_PROVIDER=mock
EMBEDDING_API_URL=
EMBEDDING_API_TOKEN=
EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
EMBEDDING_DIMENSIONS=384

# Optional distributed rate limiting and observability
REDIS_URL=
SENTRY_DSN=
LOG_LEVEL=INFO

